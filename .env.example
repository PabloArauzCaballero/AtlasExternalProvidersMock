MOCK_PROVIDERS_PORT=4010
# Escenario por defecto del namespace legacy (el trafico que no declara corrida).
MOCK_PROVIDERS_SCENARIO=happy_path
# Red para un modulo que no declare latencyRangeMs propio (los ocho ya lo declaran).
MOCK_PROVIDERS_DEFAULT_LATENCY_MS=300
# Techo de x-mock-latency-ms. Una cabecera con 10^9 no es una prueba de cola: es un cuelgue.
MOCK_PROVIDERS_MAX_LATENCY_MS=30000
# Cuanto se suma al retraso en el escenario `timeout`, por encima del deadline del consumidor.
MOCK_PROVIDERS_TIMEOUT_EXTRA_MS=9000
# Fraccion de llamadas que falla sola, para demos. 0 = apagado (el valor normal).
MOCK_PROVIDERS_ERROR_RATE=0
# Tamano maximo del cuerpo. Por encima: 413, y la conexion se cierra.
MOCK_PROVIDERS_MAX_BODY_BYTES=65536

# Estricto: un escenario que el proveedor no sabe representar es 422 con la lista de los que si,
# en vez de caer al camino feliz. Ponerlo en false reintroduce el hallazgo H06 del paquete QA
# (un escenario desconocido devolvia 200 FOUND) y solo deberia hacerse para desbloquear a un
# consumidor legacy, con fecha de retiro.
MOCK_PROVIDERS_STRICT_SCENARIOS=true

# Plano de control (/mock/control/*): alta de corridas, plan de fallos, journal y reset con
# alcance. SIN este token las rutas responden 503 — un emulador desplegado sin configurar no
# puede quedar administrable por cualquiera que alcance su red. Minimo 16 caracteres.
# MOCK_PROVIDERS_CONTROL_TOKEN=
#
# El mismo token protege las dos rutas legacy con efecto (POST /mock/scenarios/active y
# POST /mock/reset): con token, exigen `authorization: Bearer <token>`; SIN token sólo las acepta
# desde la propia máquina (127.0.0.1/::1, sin cabeceras de proxy). Desde otro contenedor o desde
# internet: 403.

# Orígenes de NAVEGADOR admitidos por CORS, separados por comas, exactos (esquema://host[:puerto]).
# Vacío = sólo http://localhost:* y http://127.0.0.1:* (desarrollo). Con valor = SÓLO esos (el de
# desarrollo no se suma solo). Un origen fuera de la lista no recibe Access-Control-Allow-Origin.
# Lo necesita el QA Lab del portal interno, que llama a los proveedores desde el navegador:
# poner aquí el origen del portal que lo sirve. Ej.: http://localhost:5273,http://161.97.85.216:3020
MOCK_PROVIDERS_CORS_ORIGINS=

# Techos de memoria: el estado de las corridas vive en el proceso y no puede crecer sin fin.
MOCK_PROVIDERS_MAX_NAMESPACES=200
MOCK_PROVIDERS_NAMESPACE_TTL_MS=3600000
MOCK_PROVIDERS_JOURNAL_MAX_ENTRIES=2000
